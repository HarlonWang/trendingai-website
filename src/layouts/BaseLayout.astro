---
import { ViewTransitions } from "astro:transitions";
import "../styles/global.css";
import { SITE_URL, rssUrl } from "../config";
import { resolveLocale, localizePath, htmlLang, ogLocale } from "../i18n";
import Feedback from "../components/Feedback.astro";

interface Props {
    title: string;
    description: string;
    /** 语言无关路径（如 "/feed/"），布局按当前语言拼出 canonical 与 hreflang */
    canonicalPath: string;
    bodyClass?: string;
}

const { title, description, canonicalPath, bodyClass } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const canonical = `${SITE_URL}${localizePath(locale, canonicalPath)}`;
const ogImage = `${SITE_URL}/android_screenshot_zh.png`;
---

<!doctype html>
<html lang={htmlLang(locale)} data-locale={locale}>
    <head>
        <script is:inline>
            // 英文页 → /zh/ 对应页的自动跳转（仅 en → zh 单向，英文保持默认）：
            // 偏好为 zh 时始终跳；无偏好时按系统语言判断；显式选过英文则不跳。
            (function () {
                var pref = null;
                try { pref = localStorage.getItem("preferred-lang"); } catch (_) {}
                var path = location.pathname;
                if (path === "/zh" || path.indexOf("/zh/") === 0) return;
                if (pref !== "zh") {
                    if (pref) return;
                    var sys = (navigator.languages && navigator.languages[0]) || navigator.language || "";
                    if (sys.toLowerCase().indexOf("zh") !== 0) return;
                }
                location.replace("/zh" + path + location.search + location.hash);
            })();
        </script>
        <script is:inline>
            (function() {
                var mode = (function() {
                    try { return localStorage.getItem("preferred-theme"); } catch (_) { return null; }
                })() || "auto";
                var theme = mode === "dark" ? "dark" : mode === "light" ? "light"
                    : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
                document.documentElement.setAttribute("data-theme", theme);
                document.documentElement.setAttribute("data-theme-mode", mode);
                document.documentElement.style.backgroundColor = theme === "dark" ? "#030712" : "#ffffff";
            })();
        </script>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <link rel="icon" href="/favicon.ico" />
        <link rel="icon" type="image/png" href="/ic_launcher.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="en" href={`${SITE_URL}${canonicalPath}`} />
        <link rel="alternate" hreflang="zh-CN" href={`${SITE_URL}/zh${canonicalPath}`} />
        <link rel="alternate" hreflang="x-default" href={`${SITE_URL}${canonicalPath}`} />
        <link rel="alternate" type="application/rss+xml" title={locale === "zh" ? "TrendingAI - 每日技术趋势" : "TrendingAI - Daily Tech Trends"} href={rssUrl(locale)} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:locale" content={ogLocale(locale)} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
        {locale === "zh" ? (
            <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet" />
        ) : (
            <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
        )}
        <ViewTransitions />
        <title>{title}</title>
    </head>
    <body class={bodyClass || undefined}>
        <slot />
        <Feedback />
    </body>
</html>
