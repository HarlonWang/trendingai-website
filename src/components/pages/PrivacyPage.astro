---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopNav from "../TopNav.astro";
import Footer from "../Footer.astro";
import { resolveLocale, t } from "../../i18n";

const locale = resolveLocale(Astro.currentLocale);
---

<BaseLayout
    title={t(locale, "privacy.title")}
    description={t(locale, "privacy.description")}
    canonicalPath="/privacy/"
>
    <TopNav />
    <main class="pt-20 pb-16 px-4">
        <article class="max-w-3xl mx-auto prose">
            {locale === "zh" ? (
                <>
                    <h1>隐私政策</h1>
                    <p class="text-secondary">最后更新：2026 年 8 月 7 日</p>

                    <p>
                        Trending AI（以下简称"我们"）重视您的隐私。本政策说明我们在您使用 Trending AI
                        应用程序及网站（trendingai.cn）时如何收集、使用和保护您的信息。
                    </p>

                    <h2>我们收集的信息</h2>

                    <h3>基础使用数据</h3>
                    <p>
                        我们通过 Aptabase（一款注重隐私的分析工具）收集使用统计，包括：
                    </p>
                    <ul>
                        <li>应用启动次数</li>
                        <li>会话时长</li>
                        <li>功能使用情况（如筛选条件的选择）</li>
                    </ul>
                    <p>
                        这些统计不包含您的姓名、邮箱等直接身份信息，但会附带下方所述的安装标识，
                        因此可以关联同一台设备在不同时间的使用记录。
                    </p>

                    <h3>用户偏好设置</h3>
                    <p>
                        我们在您的设备本地存储以下偏好设置，这些数据不会上传至服务器：
                    </p>
                    <ul>
                        <li>主题模式（浅色 / 深色 / 跟随系统）</li>
                        <li>语言偏好</li>
                    </ul>

                    <h3>API 请求参数</h3>
                    <p>
                        当您浏览内容时，应用会向我们的服务器发送必要的请求参数（如时间周期、编程语言筛选等），
                        用于返回您需要的数据。这些参数不与任何用户身份关联。
                    </p>

                    <h3>账号信息</h3>
                    <p>
                        登录是可选的 —— 不登录仍可浏览全部榜单内容，但无法使用 AI 对话与 Pro 功能。
                        当您选择登录时，我们通过 Logto 处理认证流程，并存储：邮箱地址，以及第三方账号的
                        公开资料（如 GitHub 用户名、显示名、头像、简介）。
                    </p>

                    <h3>安装标识</h3>
                    <p>
                        应用首次启动时会生成一个随机的安装标识（install_id），用于区分不同安装、进行留存
                        分析和配额控制。它不读取任何设备硬件信息（不涉及 IMEI、ANDROID_ID 等），卸载重装后
                        会重新生成 —— 但在此之前保持不变，因此可用于关联您在不同时间的使用记录。
                    </p>

                    <h3>AI 功能使用记录</h3>
                    <p>
                        当您使用 AI 对话、详细解读或深度调研功能时，我们会记录所用模型、消耗的额度与时间，
                        用于计费和配额控制。深度调研功能还会保存您提交的调研主题与生成的报告，以便您后续查看。
                    </p>

                    <h3>反馈信息</h3>
                    <p>
                        当您提交反馈时，我们会记录反馈内容，以及您选填的邮箱、页面地址和浏览器标识。
                        我们不记录您的 IP 地址。
                    </p>

                    <h2>我们不收集的信息</h2>
                    <ul>
                        <li>精确地理位置信息</li>
                        <li>通讯录、日历、文件等设备敏感数据</li>
                        <li>支付信息（Pro 通过 GitHub Sponsors 处理，我们不接触您的支付资料）</li>
                    </ul>

                    <h2>数据共享</h2>
                    <p>
                        我们不出售或出租您的个人数据。为提供服务，我们会与以下第三方共享必要数据：
                    </p>
                    <h3>AI 服务提供商（OpenAI）</h3>
                    <p>
                        您在 AI 功能中发送的内容会传输至 OpenAI 以生成回复。我们目前参与了 OpenAI 的数据
                        共享计划，这意味着<strong>您的输入与输出会被 OpenAI 用于改进和训练其模型</strong>，
                        并在其服务器上留存约 30 天。<strong>请不要在对话中输入敏感、机密或个人信息。</strong>
                    </p>
                    <h3>其他服务商</h3>
                    <ul>
                        <li>Logto：登录认证</li>
                        <li>Aptabase：使用统计</li>
                        <li>Resend：订阅邮件发送（含打开情况统计）</li>
                        <li>Cloudflare：服务器与数据库托管</li>
                    </ul>

                    <h2>数据安全</h2>
                    <p>
                        所有网络通信均使用 HTTPS 加密。主题、语言等偏好设置仅存储在您的设备本地；
                        账号信息与使用记录存储在 Cloudflare 的数据库中。
                    </p>

                    <h2>数据保留</h2>
                    <ul>
                        <li>账号信息：保留至您注销账号</li>
                        <li>AI 功能使用记录与深度调研报告：保留至您注销账号</li>
                        <li>反馈信息：保留 12 个月</li>
                        <li>使用统计：由 Aptabase 按其策略保留</li>
                    </ul>

                    <h2>您的权利</h2>
                    <p>
                        您可以通过 GitHub Issue 或应用内反馈入口联系我们，请求查询、导出或删除您的个人数据。
                    </p>

                    <h2>儿童隐私</h2>
                    <p>
                        我们的应用不针对 13 岁以下的儿童，也不会故意收集儿童的个人信息。
                    </p>

                    <h2>隐私政策的更新</h2>
                    <p>
                        我们可能会不时更新本隐私政策。更新后的政策将在本页面发布，并更新顶部的"最后更新"日期。
                    </p>

                    <h2>联系我们</h2>
                    <p>
                        如果您对本隐私政策有任何疑问，请通过以下方式联系我们：
                    </p>
                    <ul>
                        <li>运营者：WANG HAILONG（个人开发者）</li>
                        <li>邮箱：<a href="mailto:81813780@qq.com">81813780@qq.com</a></li>
                        <li>GitHub：<a href="https://github.com/HarlonWang/TrendingAI/issues" target="_blank" rel="noopener">提交 Issue</a></li>
                    </ul>
                </>
            ) : (
                <>
                    <h1>Privacy Policy</h1>
                    <p class="text-secondary">Last Updated: August 7, 2026</p>

                    <p>
                        Trending AI ("we") values your privacy. This policy explains how we collect, use, and
                        protect your information when you use the Trending AI app and website (trendingai.cn).
                    </p>

                    <h2>Information We Collect</h2>

                    <h3>Basic Usage Data</h3>
                    <p>
                        We collect usage statistics through Aptabase, a privacy-focused analytics tool,
                        including:
                    </p>
                    <ul>
                        <li>App launch count</li>
                        <li>Session duration</li>
                        <li>Feature usage (e.g., filter selections)</li>
                    </ul>
                    <p>
                        These statistics do not contain direct identifiers such as your name or email, but they
                        do carry the installation identifier described below, which allows usage from the same
                        device to be linked across time.
                    </p>

                    <h3>User Preferences</h3>
                    <p>
                        The following preferences are stored locally on your device and are never uploaded to our
                        servers:
                    </p>
                    <ul>
                        <li>Theme mode (light / dark / system)</li>
                        <li>Language preference</li>
                    </ul>

                    <h3>API Request Parameters</h3>
                    <p>
                        When you browse content, the app sends necessary request parameters (such as time period
                        and programming language filters) to our servers to return the data you need. These
                        parameters are not associated with any user identity.
                    </p>

                    <h3>Account Information</h3>
                    <p>
                        Signing in is optional — you can browse all rankings without an account, though AI chat
                        and Pro features require one. When you choose to sign in, we handle authentication through
                        Logto and store your email address along with public profile data from the third-party
                        account (such as GitHub username, display name, avatar, and bio).
                    </p>

                    <h3>Installation Identifier</h3>
                    <p>
                        On first launch, the app generates a random installation identifier (install_id) used to
                        distinguish installations, analyze retention, and enforce quotas. It reads no device
                        hardware information (no IMEI, ANDROID_ID, etc.) and is regenerated after reinstalling —
                        but until then it stays constant, so it can link your usage across time.
                    </p>

                    <h3>AI Feature Usage Records</h3>
                    <p>
                        When you use AI chat, detailed analysis, or deep research, we record the model used,
                        credits consumed, and timestamps for billing and quota control. Deep research also saves
                        the topic you submitted and the generated report so you can revisit it later.
                    </p>

                    <h3>Feedback</h3>
                    <p>
                        When you submit feedback, we record its content along with the email you optionally
                        provide, the page URL, and your browser identifier. We do not record your IP address.
                    </p>

                    <h2>Information We Do Not Collect</h2>
                    <ul>
                        <li>Precise geographic location</li>
                        <li>Contacts, calendar, files, or other sensitive device data</li>
                        <li>Payment information (Pro is handled via GitHub Sponsors; we never see your payment details)</li>
                    </ul>

                    <h2>Data Sharing</h2>
                    <p>
                        We do not sell or rent your personal data. To provide our service, we share necessary data
                        with the following third parties:
                    </p>
                    <h3>AI Service Provider (OpenAI)</h3>
                    <p>
                        Content you send through AI features is transmitted to OpenAI to generate responses. We
                        currently participate in OpenAI's data sharing program, which means
                        <strong>your inputs and outputs are used by OpenAI to improve and train their models</strong>,
                        and are retained on their servers for about 30 days.
                        <strong>Please do not enter sensitive, confidential, or personal information in conversations.</strong>
                    </p>
                    <h3>Other Service Providers</h3>
                    <ul>
                        <li>Logto: authentication</li>
                        <li>Aptabase: usage statistics</li>
                        <li>Resend: newsletter delivery (including open tracking)</li>
                        <li>Cloudflare: server and database hosting</li>
                    </ul>

                    <h2>Data Security</h2>
                    <p>
                        All network communications are encrypted using HTTPS. Preferences such as theme and
                        language are stored only on your device; account information and usage records are stored
                        in Cloudflare's database.
                    </p>

                    <h2>Data Retention</h2>
                    <ul>
                        <li>Account information: retained until you delete your account</li>
                        <li>AI feature usage records and deep research reports: retained until you delete your account</li>
                        <li>Feedback: retained for 12 months</li>
                        <li>Usage statistics: retained per Aptabase's own policy</li>
                    </ul>

                    <h2>Your Rights</h2>
                    <p>
                        You may contact us via GitHub Issues or the in-app feedback form to request access to,
                        export of, or deletion of your personal data.
                    </p>

                    <h2>Children's Privacy</h2>
                    <p>
                        Our app is not directed at children under 13, and we do not knowingly collect personal
                        information from children.
                    </p>

                    <h2>Changes to This Policy</h2>
                    <p>
                        We may update this privacy policy from time to time. Updated policies will be posted on
                        this page with a revised "Last Updated" date.
                    </p>

                    <h2>Contact Us</h2>
                    <p>
                        If you have any questions about this privacy policy, please contact us:
                    </p>
                    <ul>
                        <li>Operator: WANG HAILONG (individual developer)</li>
                        <li>Email: <a href="mailto:81813780@qq.com">81813780@qq.com</a></li>
                        <li>GitHub: <a href="https://github.com/HarlonWang/TrendingAI/issues" target="_blank" rel="noopener">Open an Issue</a></li>
                    </ul>
                </>
            )}
        </article>
    </main>
    <Footer />
</BaseLayout>

<style>
    .prose {
        color: var(--color-on-surface);
        line-height: 1.75;
    }
    .prose h1 {
        font-size: 2rem;
        font-weight: 700;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        color: var(--color-on-surface);
    }
    .prose h1:first-child {
        margin-top: 0;
    }
    .prose h2 {
        font-size: 1.375rem;
        font-weight: 600;
        margin-top: 2rem;
        margin-bottom: 0.75rem;
        color: var(--color-on-surface);
    }
    .prose h3 {
        font-size: 1.125rem;
        font-weight: 600;
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
        color: var(--color-on-surface);
    }
    .prose p {
        margin-bottom: 1rem;
    }
    .prose ul {
        list-style-type: disc;
        padding-left: 1.5rem;
        margin-bottom: 1rem;
    }
    .prose li {
        margin-bottom: 0.25rem;
    }
    .prose a {
        color: var(--color-primary);
        text-decoration: underline;
    }
    .text-secondary {
        color: var(--color-on-surface-variant);
        font-size: 0.875rem;
    }
</style>
