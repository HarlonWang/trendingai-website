---
import { resolveLocale, t } from "../i18n";

const DOWNLOAD_URL = "https://download.trendingai.cn/TrendingAI-latest.apk";
const GOOGLE_PLAY_URL = "https://play.google.com/store/apps/details?id=whl.trending.ai";
const GITHUB_URL = "https://github.com/HarlonWang/TrendingAI";

const locale = resolveLocale(Astro.currentLocale);

const features = [
    { title: t(locale, "app.feature1Title"), desc: t(locale, "app.feature1Desc") },
    { title: t(locale, "app.feature2Title"), desc: t(locale, "app.feature2Desc") },
    { title: t(locale, "app.feature3Title"), desc: t(locale, "app.feature3Desc") },
    { title: t(locale, "app.feature4Title"), desc: t(locale, "app.feature4Desc") },
];
---

<section class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <div class="grid items-center gap-10 md:grid-cols-[1fr_320px]">
        <div>
            <h1 class="text-3xl font-extrabold tracking-tight text-on-surface sm:text-4xl lg:text-5xl">
                {t(locale, "app.heroTitleLine1")}<br />{t(locale, "app.heroTitleLine2")}
            </h1>
            <p class="mt-4 max-w-lg text-lg text-on-surface-variant">
                {t(locale, "app.heroDesc")}
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3">
                <a
                    class="inline-flex items-center rounded-xl bg-primary px-5 py-2.5 text-sm font-bold text-on-primary shadow-sm transition-transform hover:-translate-y-0.5"
                    href={DOWNLOAD_URL}
                    target="_blank"
                    rel="noreferrer"
                >
                    {t(locale, "app.downloadApk")}
                </a>
                <a
                    class="inline-flex items-center gap-2 rounded-xl border border-outline px-5 py-2.5 text-sm font-bold text-on-surface-variant transition-transform hover:-translate-y-0.5"
                    href={GOOGLE_PLAY_URL}
                    target="_blank"
                    rel="noreferrer"
                >
                    <svg class="size-4" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true">
                        <path d="M325.3 234.3L104.6 13l280.8 161.2-60.1 60.1zM47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0zm425.2 225.6l-58.9-34.1-65.7 64.5 65.7 64.5 60.1-34.1c18-14.3 18-46.5-1.2-60.8zM104.6 499l280.8-161.2-60.1-60.1L104.6 499z" />
                    </svg>
                    {t(locale, "app.googlePlay")}
                </a>
                <a
                    class="inline-flex items-center gap-2 rounded-xl border border-outline px-5 py-2.5 text-sm font-bold text-on-surface-variant transition-transform hover:-translate-y-0.5"
                    href={GITHUB_URL}
                    target="_blank"
                    rel="noreferrer"
                >
                    <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                    </svg>
                    {t(locale, "app.githubSource")}
                </a>
                <div class="hidden items-center gap-2 md:flex">
                    <img
                        src="/qr-apk.svg"
                        alt={t(locale, "app.qrAlt")}
                        class="h-16 w-16 rounded-lg border border-outline bg-white p-1"
                        width="64"
                        height="64"
                        loading="lazy"
                        decoding="async"
                    />
                    <p class="text-xs text-on-surface-variant leading-relaxed">
                        {t(locale, "app.qrLine1")}<br />{t(locale, "app.qrLine2")}
                    </p>
                </div>
            </div>

            <div class="mt-10 grid gap-3 sm:grid-cols-2">
                {features.map((f) => (
                    <div class="rounded-xl border border-outline bg-surface-container p-4">
                        <h3 class="text-sm font-bold text-on-surface">{f.title}</h3>
                        <p class="mt-1 text-xs text-on-surface-variant leading-relaxed">{f.desc}</p>
                    </div>
                ))}
            </div>
        </div>

        <div class="justify-self-center md:justify-self-end">
            <video
                src={`/app-demo-${locale}.mp4`}
                poster={`/app-demo-poster-${locale}.jpg`}
                class="w-64 rounded-3xl border-8 border-neutral-900 bg-neutral-900 shadow-2xl"
                width="720"
                height="1600"
                autoplay
                loop
                muted
                playsinline
                preload="metadata"
                aria-label={t(locale, "app.screenshotAlt")}></video>
        </div>
    </div>
</section>
