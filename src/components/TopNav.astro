---
import ThemeToggle from "./ThemeToggle.astro";
import { resolveLocale, localizePath, t } from "../i18n";

interface Props {
    activeRoute?: "home" | "feed" | "app";
}

const { activeRoute } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);

const links = [
    { id: "home", label: t(locale, "nav.home"), href: localizePath(locale, "/") },
    { id: "feed", label: t(locale, "nav.feed"), href: localizePath(locale, "/feed/") },
    { id: "app", label: t(locale, "nav.app"), href: localizePath(locale, "/app/") },
] as const;

// 语言选择：当前路径去掉 /zh 前缀得到语言无关路径，菜单项各自指向同一页面的两种语言版本。
// "跟随系统"= 清除偏好后按 navigator.language 跳转（点击时由脚本计算目标），href 仅作无 JS 兜底。
// 勾选标记反映 localStorage 里的偏好（构建期拿不到），由脚本在运行时标记，无偏好时勾"跟随系统"。
const pathname = Astro.url.pathname;
const basePath = pathname.startsWith("/zh/") ? pathname.slice(3) : pathname;
const langOptions = [
    { code: "auto", label: t(locale, "nav.langSystem"), href: basePath },
    { code: "en", label: "English", href: basePath },
    { code: "zh", label: "中文", href: `/zh${basePath}` },
] as const;
---

<header class="top-bar fixed top-0 left-0 right-0 z-50 transition-shadow duration-300">
    <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4 sm:px-6">
        <a class="flex items-center gap-2.5" href={localizePath(locale, "/")} aria-label={t(locale, "nav.home")}>
            <img class="size-8 rounded-full" src="/ic_launcher.png" alt="TrendingAI Logo" loading="eager" />
            <span class="hidden sm:inline text-base font-extrabold text-on-surface">Trending AI</span>
        </a>
        <div class="flex items-center gap-1">
            {links.map((link) => (
                <a
                    class:list={[
                        "rounded-lg px-2 sm:px-3 py-1.5 text-sm font-medium transition-colors",
                        activeRoute === link.id
                            ? "bg-primary text-on-primary"
                            : "text-on-surface-variant hover:bg-surface-container hover:text-on-surface",
                    ]}
                    href={link.href}
                >
                    {link.label}
                </a>
            ))}
            <div class="relative" data-lang-root>
                <button
                    type="button"
                    data-lang-menu-btn
                    aria-haspopup="menu"
                    aria-expanded="false"
                    title={t(locale, "nav.langMenuTitle")}
                    class="flex items-center gap-1 rounded-lg px-2 sm:px-3 py-1.5 text-sm font-medium text-on-surface-variant transition-colors hover:bg-surface-container hover:text-on-surface"
                >
                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M2 12h20"></path>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                    </svg>
                    <span>{t(locale, "nav.langCurrent")}</span>
                    <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m6 9 6 6 6-6"></path>
                    </svg>
                </button>
                <div
                    data-lang-menu
                    class="hidden absolute right-0 top-full z-50 mt-1 min-w-28 rounded-lg border border-outline bg-surface-container py-1 shadow-lg"
                >
                    {langOptions.map((opt) => (
                        <a
                            class="flex items-center justify-between gap-3 px-3 py-1.5 text-sm text-on-surface-variant transition-colors hover:bg-surface hover:text-on-surface"
                            href={opt.href}
                            data-lang-switch={opt.code}
                        >
                            {opt.label}
                            <svg class="size-3.5 hidden" data-lang-check viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M20 6 9 17l-5-5"></path>
                            </svg>
                        </a>
                    ))}
                </div>
            </div>
            <a
                class="ml-1 flex size-8 items-center justify-center rounded-lg text-on-surface-variant transition-colors hover:bg-surface-container hover:text-on-surface"
                href="https://github.com/HarlonWang/trendingai-website"
                target="_blank"
                rel="noopener noreferrer"
                title="Star on GitHub"
                aria-label="Star on GitHub"
            >
                <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                </svg>
            </a>
            <div>
                <ThemeToggle />
            </div>
        </div>
    </nav>
</header>

<script is:inline>
    // 语言菜单开合 + 记录显式语言选择（配合 BaseLayout 的自动重定向：偏好 zh 强制跳，偏好 en 不跳）。
    // "跟随系统"清除偏好并按系统语言即时跳转；勾选标记按 localStorage 运行时标注。
    // 事件委托 + 脚本内容跨语言一致，避免 ClientRouter 跨语言导航时重复注册监听器
    (function () {
        function closeMenus() {
            document.querySelectorAll("[data-lang-menu]").forEach(function (m) {
                m.classList.add("hidden");
            });
            document.querySelectorAll("[data-lang-menu-btn]").forEach(function (b) {
                b.setAttribute("aria-expanded", "false");
            });
        }

        function markActiveLang() {
            var pref = null;
            try { pref = localStorage.getItem("preferred-lang"); } catch (_) {}
            var active = pref === "en" || pref === "zh" ? pref : "auto";
            document.querySelectorAll("[data-lang-switch]").forEach(function (item) {
                var check = item.querySelector("[data-lang-check]");
                if (check) check.classList.toggle("hidden", item.getAttribute("data-lang-switch") !== active);
            });
        }

        markActiveLang();
        document.addEventListener("astro:page-load", markActiveLang);

        document.addEventListener("click", function (e) {
            var target = e.target;
            if (!target || !target.closest) return;

            var a = target.closest("[data-lang-switch]");
            if (a) {
                var code = a.getAttribute("data-lang-switch");
                if (code === "auto") {
                    e.preventDefault();
                    try { localStorage.removeItem("preferred-lang"); } catch (_) {}
                    markActiveLang();
                    closeMenus();
                    var path = location.pathname;
                    var base = path === "/zh" ? "/" : path.indexOf("/zh/") === 0 ? path.slice(3) : path;
                    var sys = (navigator.languages && navigator.languages[0]) || navigator.language || "";
                    var dest = sys.toLowerCase().indexOf("zh") === 0 ? "/zh" + base : base;
                    if (dest !== path) location.href = dest + location.search + location.hash;
                    return;
                }
                try { localStorage.setItem("preferred-lang", code); } catch (_) {}
                closeMenus();
                return;
            }

            var btn = target.closest("[data-lang-menu-btn]");
            if (btn) {
                var menu = btn.parentElement.querySelector("[data-lang-menu]");
                if (!menu) return;
                var opening = menu.classList.contains("hidden");
                closeMenus();
                if (opening) {
                    menu.classList.remove("hidden");
                    btn.setAttribute("aria-expanded", "true");
                }
                return;
            }

            closeMenus();
        });

        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape") closeMenus();
        });
    })();
</script>

<script is:inline>
    (function() {
        var _onScroll = null;
        document.addEventListener("astro:page-load", function() {
            if (_onScroll) window.removeEventListener("scroll", _onScroll);
            var header = document.querySelector(".top-bar");
            if (!header) return;
            _onScroll = function() {
                if (window.scrollY > 10) {
                    header.classList.add("scrolled");
                } else {
                    header.classList.remove("scrolled");
                }
            };
            _onScroll();
            window.addEventListener("scroll", _onScroll, { passive: true });
        });
    })();
</script>
